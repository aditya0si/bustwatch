# BustWatch Environment Configuration
APP_NAME=BustWatch
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Data Sources & Ingestion
USE_SYNTHETIC_FALLBACK=true
NOAA_S3_BUCKET=noaa-gfs-bdp-pds
OPEN_METEO_BASE_URL=https://ensemble-api.open-meteo.com/v1/ensemble

# ML Configuration
MODEL_DIR=artifacts/models
EVALS_DIR=evals
RANDOM_SEED=42
CALIBRATION_METHOD=isotonic
LEAD_TIME_DAYS_MAX=10
